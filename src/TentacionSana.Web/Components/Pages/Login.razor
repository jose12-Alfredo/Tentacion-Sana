@page "/login"
@inject IPublicCatalogService CatalogService
@inject ILoggerFactory LoggerFactory

<PageTitle>Iniciar sesión | Tentación Sana</PageTitle>

<main class="login-shell">
    <section class="login-branding" aria-labelledby="brand-title">
        <div class="brand-topline">
            <a class="brand-logo" href="/" aria-label="Tentación Sana, sitio público">
                <img src="/images/brand/logo-oficial-tentacion-sana.png" alt="Tentación Sana" />
            </a>
            <span class="brand-system-label">Sistema de gestión</span>
        </div>

        <div class="brand-message">
            <p class="brand-kicker">Operación central</p>
            <h2 id="brand-title">Gestiona Tentación Sana desde un solo lugar.</h2>
            <p class="brand-modules">Pedidos <span aria-hidden="true">·</span> Producción <span aria-hidden="true">·</span> Entregas <span aria-hidden="true">·</span> Finanzas</p>
        </div>

        @if (_featuredProduct is not null)
        {
            <figure class="brand-product">
                <img src="@CloudinaryUrl(_featuredProduct.ImageUrl, 960)"
                     alt="@_featuredProduct.ImageAltText"
                     width="@_featuredProduct.ImageWidth"
                     height="@_featuredProduct.ImageHeight"
                     fetchpriority="high" />
                <figcaption>
                    <span>Producto destacado</span>
                    <strong>@_featuredProduct.Name</strong>
                </figcaption>
            </figure>
        }

        <p class="brand-footnote">Pedidos · Producción · Entregas · Clientes · Caja · Inventario</p>
    </section>

    <section class="login-access" aria-labelledby="login-title">
        <div class="login-card">
            <header class="login-heading">
                <p class="login-brand-name">Tentación Sana</p>
                <p class="login-system-name">Sistema de gestión</p>
                <h1 id="login-title">Inicia sesión</h1>
                <p>Ingresa tus credenciales para acceder al sistema.</p>
            </header>

            @if (ErrorMessage is not null)
            {
                <div class="login-alert" role="alert" aria-live="assertive">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 8v5m0 3.25v.01M12 3.75a8.25 8.25 0 1 0 0 16.5 8.25 8.25 0 0 0 0-16.5Z" />
                    </svg>
                    <div>
                        <strong>No pudimos iniciar la sesión</strong>
                        <span>@ErrorMessage</span>
                    </div>
                </div>
            }

            <form class="login-form" method="post" action="/account/login" data-login-form>
                <AntiforgeryToken />

                <div class="form-field">
                    <label for="username">Usuario</label>
                    <input id="username"
                           name="UserName"
                           type="text"
                           placeholder="Ingresa tu usuario"
                           autocomplete="username"
                           autocapitalize="none"
                           spellcheck="false"
                           required />
                    <span class="field-hint">Usa el usuario asignado a tu cuenta.</span>
                </div>

                <div class="form-field">
                    <label for="password">Contraseña</label>
                    <div class="password-field">
                        <input id="password"
                               name="Password"
                               type="password"
                               placeholder="Ingresa tu contraseña"
                               autocomplete="current-password"
                               required />
                        <button type="button"
                                class="password-toggle"
                                data-password-toggle
                                aria-controls="password"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">
                            <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2.75 12s3.25-5.25 9.25-5.25S21.25 12 21.25 12 18 17.25 12 17.25 2.75 12 2.75 12Z" />
                                <circle cx="12" cy="12" r="2.25" />
                            </svg>
                            <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4.25 4.25 19.75 19.75M9.7 6.98A9.93 9.93 0 0 1 12 6.72c6 0 9.25 5.28 9.25 5.28a15.63 15.63 0 0 1-2.45 3.03m-3.14 2.02a9.45 9.45 0 0 1-3.66.23C6 17.28 2.75 12 2.75 12a15.44 15.44 0 0 1 3.12-3.64m4.54 1.98a2.25 2.25 0 0 0 3.18 3.18" />
                            </svg>
                        </button>
                    </div>
                </div>

                <button class="login-submit" type="submit" data-login-submit>
                    <span class="submit-label-default">Iniciar sesión</span>
                    <span class="submit-label-loading" aria-live="polite">
                        <span class="submit-spinner" aria-hidden="true"></span>
                        Iniciando sesión...
                    </span>
                </button>
            </form>

            <a class="public-return" href="/">
                <span aria-hidden="true">←</span>
                Volver al sitio público
            </a>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private LandingProductSlide? _featuredProduct;

    private string? ErrorMessage => Error?.ToLowerInvariant() switch
    {
        "credenciales" => "Usuario o contraseña incorrectos.",
        "bloqueada" => "La cuenta está temporalmente bloqueada. Inténtalo nuevamente más tarde.",
        null or "" => null,
        _ => "Tu sesión no pudo iniciarse. Inténtalo nuevamente."
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _featuredProduct = (await CatalogService.GetLandingProductsAsync()).FirstOrDefault();
        }
        catch (Exception exception)
        {
            LoggerFactory.CreateLogger("Login").LogWarning(
                exception,
                "No se pudo cargar la imagen destacada del catálogo para el inicio de sesión.");
        }
    }

    private static string CloudinaryUrl(string url, int width)
    {
        const string marker = "/upload/";
        var index = url.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        return index < 0
            ? url
            : url.Insert(index + marker.Length, $"f_auto,q_auto:good,c_fill,g_auto,w_{width}/");
    }
}
