    [Microsoft.JSInterop.JSInvokable]
    public async Task ToggleStopFromMap(string orderId)
    {
        if (!Guid.TryParse(orderId, out var id) || _board is null) return;
        if (_currentRoute is not null)
        {
            SetMessage("Pulsa 'Armar otra ruta' para seleccionar nuevos pines.", true);
            await InvokeAsync(StateHasChanged);
            return;
        }

        var item = _board.Items.FirstOrDefault(x => x.OrderId == id);
        if (item is null || !item.CanAddToRoute)
        {
            SetMessage("Este punto ya está en reparto o no está disponible para una ruta nueva.", true);
            await InvokeAsync(StateHasChanged);
            return;
        }

        ToggleOne(id);
        _message = null;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenIncident(DeliveryBoardItem item) { _incidentDeliveryId = item.DeliveryId; _incidentVersion = item.DeliveryVersion; _incidentType = "Local cerrado"; _incidentNotes = string.Empty; }
    private void CloseIncident() => _incidentDeliveryId = null;
    private async Task ReportIncidentAsync()
    {
        if (_incidentDeliveryId is null) return;
        _saving = true;
        var reason = string.IsNullOrWhiteSpace(_incidentNotes) ? _incidentType : $"{_incidentType}: {_incidentNotes.Trim()}";
        var result = await Service.FailAsync(_incidentDeliveryId.Value, _incidentVersion, reason, await UserIdAsync());
        _saving = false;
        if (result.Succeeded) CloseIncident();
        SetMessage(result.Succeeded ? "Incidencia registrada en el historial de la entrega." : string.Join(" ", result.Errors), !result.Succeeded);
        await ReloadAsync();
    }

    private void SetMessage(string message, bool error) { _message = message; _isError = error; }
    private async Task<Guid> UserIdAsync() { var state = await Auth.GetAuthenticationStateAsync(); return Guid.Parse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value); }
    public async ValueTask DisposeAsync()
    {
        _mapReference?.Dispose();
        if (_mapModule is null) return;
        try
        {
            await _mapModule.InvokeVoidAsync("disposeDeliveryRouteMap", "delivery-route-map");
            await _mapModule.DisposeAsync();
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }
    private sealed record RouteMapPoint(string OrderId, long OrderNumber, string Customer, string? DeliveryPoint, string? Address, string? Reference, string? Location, double? Latitude, double? Longitude, int Physical, decimal Balance, string? MapUrl, string? ImageUrl, int? SelectedPosition, bool CanSelect);
    private sealed record RouteStopPresentation(Guid? OrderId, Guid? DeliveryId, long OrderNumber, string Customer, string? DeliveryPoint, string? Address, string? Reference, string? Location, double? Latitude, double? Longitude, int SalePending, int ReplacementPending, int TastingPending, decimal Balance, int Position) { public int Physical => SalePending + ReplacementPending + TastingPending; }
