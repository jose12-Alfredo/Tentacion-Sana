@page "/app/pedidos"
@page "/app/pedidos/nuevo"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.ManageSales)]
@inject IOrderManagementService Service
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Pedidos | Tentación Sana</PageTitle>
<header class="orders-heading"><div><h1>Pedidos</h1><p>Controla ventas, entregas y pagos de forma práctica.</p></div><a href="/app/pedidos/nuevo" data-enhance-nav="false" class="primary-action"><span>+</span> Nuevo pedido</a></header>
@if (_error is not null) { <div class="orders-error">@_error</div> }
@if (_items is null) { <div class="orders-loading">Cargando control de pedidos…</div> }
else
{
 <section class="summary-grid" aria-label="Resumen de pedidos">
  <article><span class="summary-icon pending">▤</span><div><small>Pendientes</small><strong>@PendingCount</strong></div></article>
  <article><span class="summary-icon delivered">✓</span><div><small>Entregados</small><strong>@DeliveredCount</strong></div></article>
  <article><span class="summary-icon unpaid">▭</span><div><small>Sin pagar</small><strong>@UnpaidCount</strong></div></article>
  <article><span class="summary-icon money">Bs</span><div><small>Pendiente x cobrar</small><strong>Bs @OutstandingTotal.ToString("N2")</strong></div></article>
  <article><span class="summary-icon units">◇</span><div><small>Por entregar</small><strong>@PendingUnits</strong><span>@PendingSaleUnits venta · @PendingReplacementUnits rep. · @PendingTastingUnits deg.</span></div></article>
 </section>
 <section class="filter-card">
  <div class="filters">
   <label class="search-field"><span>⌕</span><input @bind="_search" @bind:event="oninput" placeholder="Buscar por cliente o pedido..." aria-label="Buscar pedidos" /></label>
    <label><span>Estado</span><select @bind="_statusFilter"><option value="All">Pedidos registrados</option><option value="Pending">Pendiente</option><option value="Draft">Borrador</option><option value="Delivered">Entregado</option></select></label>
   <label><span>Pago</span><select @bind="_paymentFilter"><option value="All">Todos</option><option value="Pending">No pagado</option><option value="Partial">Parcial</option><option value="Paid">Pagado</option></select></label>
   <label><span>Método</span><select @bind="_methodFilter"><option value="All">Todos</option><option value="Qr">QR</option><option value="Cash">Efectivo</option><option value="Mixed">Mixto</option></select></label>
   <label><span>Fecha de entrega</span><select @bind="_dateFilter"><option value="All">Todas</option><option value="Today">Hoy</option><option value="Tomorrow">Mañana</option><option value="Week">Esta semana</option><option value="Late">Atrasados</option></select></label>
  </div>
  <div class="quick-filters" aria-label="Filtros rápidos">
    <button class='@ChipClass("All")' @onclick='() => SetChip("All")'>Todos <span>@ListCount</span></button><button class='@ChipClass("Pending")' @onclick='() => SetChip("Pending")'>Pendientes <span>@PendingCount</span></button><button class='@ChipClass("Delivered")' @onclick='() => SetChip("Delivered")'>Entregados <span>@DeliveredCount</span></button><button class='@ChipClass("Unpaid")' @onclick='() => SetChip("Unpaid")'>Sin pagar <span>@UnpaidCount</span></button><button class='@ChipClass("Paid")' @onclick='() => SetChip("Paid")'>Pagados <span>@PaidCount</span></button><button class='@ChipClass("Qr")' @onclick='() => SetChip("Qr")'>QR <span>@_items.Count(x => x.Status!="Cancelled"&&(x.PaymentMethod is "Qr" or "Mixed"))</span></button><button class='@ChipClass("Cash")' @onclick='() => SetChip("Cash")'>Efectivo <span>@_items.Count(x => x.Status!="Cancelled"&&(x.PaymentMethod is "Cash" or "Mixed"))</span></button><button class='@ChipClass("Replacement")' @onclick='() => SetChip("Replacement")'>Con reposición <span>@_items.Count(x=>x.Status!="Cancelled"&&x.ReplacementQuantity>0)</span></button><button class='@ChipClass("Tasting")' @onclick='() => SetChip("Tasting")'>Con degustación <span>@_items.Count(x=>x.Status!="Cancelled"&&x.TastingQuantity>0)</span></button>
    <button class='@ChipClass("Draft")' @onclick='() => SetChip("Draft")'>Borradores <span>@DraftCount</span></button>
  </div>
 </section>
 <div class="orders-workspace">
   <section class="orders-list-card">
    <header><div><h2>@(_activeChip == "Draft" || _statusFilter == "Draft" ? "Borradores" : "Lista de pedidos")</h2><p>Mostrando @Filtered.Count de @(_activeChip == "Draft" || _statusFilter == "Draft" ? DraftCount : ListCount) registros.</p></div><a href="/app/pedidos/nuevo" data-enhance-nav="false" class="list-create-action"><span>+</span> Nuevo pedido</a></header>
   @if (Filtered.Count == 0) { <div class="empty-state"><strong>No encontramos pedidos.</strong><span>Prueba con otros filtros o crea un pedido nuevo.</span></div> }
   else
   {
    <div class="desktop-table"><table><thead><tr><th>Pedido</th><th>Cliente / Punto</th><th>Ubicación</th><th>Venta</th><th>Rep.</th><th>Deg.</th><th>Por entregar</th><th>Fecha entrega</th><th>Estado</th><th>Pago</th><th>Total</th><th>Pagado</th><th>Saldo</th><th><span class="sr-only">Acciones</span></th></tr></thead><tbody>
    @foreach (var x in Filtered)
    {
     <tr class="@(IsLate(x) ? "late-row" : null)"><td><a class="order-number" href="/app/pedidos/@x.Id">#@x.Number</a></td><td><div class="customer-point">@if(!string.IsNullOrWhiteSpace(x.PointImageUrl)){<img src="@x.PointImageUrl" alt="Fotografía de @(x.DeliveryPoint??x.Customer)" loading="lazy" />}else{<span class="point-placeholder">@Initials(x.Customer)</span>}<div><strong class="customer-name">@x.Customer</strong><small class="branch">@(x.DeliveryPoint??"Punto sin asignar")</small></div></div></td><td>@if(!string.IsNullOrWhiteSpace(x.LocationUrl)){<a class="location-button" href="@x.LocationUrl" target="_blank" rel="noopener noreferrer">⌖ Ubicación</a>}else{<span class="location-missing">Sin ubicación</span>}</td><td>@x.SaleQuantity</td><td>@x.ReplacementQuantity</td><td>@x.TastingQuantity</td><td><strong>@x.PendingQuantity</strong></td><td><span class="@DateClass(x)">@DeliveryDateText(x)</span></td><td><span class="status-badge @StatusClass(x.Status)">@StatusText(x.Status)</span></td><td><span class="payment-badge @PaymentClass(x.PaymentStatus)"><i></i>@PaymentSummary(x)</span></td><td class="money-cell">Bs @x.Total.ToString("N2")</td><td class="money-cell paid-money">Bs @x.Paid.ToString("N2")</td><td class="money-cell balance-money">Bs @x.Balance.ToString("N2")</td><td><details class="row-menu" data-menu-id="@x.Id" @ontoggle="() => PositionMenuAsync(x.Id)" @key="(x.Id, _menuVersion)"><summary aria-label="Acciones para pedido #@x.Number">•••</summary><nav><a href="/app/pedidos/@x.Id">Ver pedido</a>@if(x.Status is "Delivered" or "Cancelled"){<AuthorizeView Policy="@AppPolicies.Administration"><Authorized><button class="delete-menu-action" @onclick="()=>OpenArchiveDialog(x)">Eliminar de la vista</button></Authorized></AuthorizeView>}@if(x.Status!="Delivered"&&x.Status!="Cancelled"){<a href="/app/pedidos/@x.Id">Editar pedido</a><button class="delete-menu-action" @onclick="()=>OpenRemoveDialog(x)">Eliminar pedido</button>}@if(x.Status=="Confirmed"||x.Status=="InPreparation"||x.Status=="Ready"){<a href="/app/entregas">Organizar entrega</a>}@if(x.Status!="Cancelled"&&x.PaymentStatus!="Paid"){<AuthorizeView Roles="Administrador,Finanzas"><Authorized><a href="/app/pedidos/@x.Id">Registrar pago</a></Authorized></AuthorizeView>}@if(x.PaymentStatus!="Pending"){<a href="/app/pedidos/@x.Id">Ver pagos y comprobantes</a>}@if(!string.IsNullOrWhiteSpace(x.ContactPhone)){<a href="@WhatsApp(x.ContactPhone)" target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a>}@if(!string.IsNullOrWhiteSpace(x.LocationUrl)){<a href="@x.LocationUrl" target="_blank" rel="noopener noreferrer">Abrir ubicación</a>}</nav></details></td></tr>
    }
    </tbody></table></div>
    <div class="mobile-orders">@foreach (var x in Filtered){<article><header><a href="/app/pedidos/@x.Id">#@x.Number</a><span class="status-badge @StatusClass(x.Status)">@StatusText(x.Status)</span></header><div class="customer-point mobile">@if(!string.IsNullOrWhiteSpace(x.PointImageUrl)){<img src="@x.PointImageUrl" alt="Fotografía de @(x.DeliveryPoint??x.Customer)" loading="lazy" />}else{<span class="point-placeholder">@Initials(x.Customer)</span>}<div><h3>@x.Customer</h3><p class="branch">@(x.DeliveryPoint??"Punto sin asignar")</p></div></div><p>@x.SaleQuantity venta · @x.ReplacementQuantity rep. · @x.TastingQuantity degustación<br><strong>@x.PendingQuantity por entregar</strong></p><dl><div><dt>Fecha</dt><dd class="@DateClass(x)">@DeliveryDateText(x)</dd></div><div><dt>Pago</dt><dd><span class="payment-badge @PaymentClass(x.PaymentStatus)">@PaymentSummary(x)</span></dd></div><div><dt>Total</dt><dd>Bs @x.Total.ToString("N2")</dd></div><div><dt>Pagado</dt><dd class="paid-money">Bs @x.Paid.ToString("N2")</dd></div><div><dt>Saldo</dt><dd class="balance-money">Bs @x.Balance.ToString("N2")</dd></div></dl>@if(!string.IsNullOrWhiteSpace(x.LocationUrl)){<a class="location-button" href="@x.LocationUrl" target="_blank" rel="noopener noreferrer">⌖ Ubicación</a>}else{<span class="location-missing">Sin ubicación</span>}<details class="row-menu" data-menu-id="mobile-@x.Id" @ontoggle='() => PositionMenuAsync("mobile-" + x.Id)' @key="(x.Id, _menuVersion)"><summary aria-label="Acciones para pedido #@x.Number">•••</summary><nav><a href="/app/pedidos/@x.Id">Ver pedido</a>@if(x.Status is "Delivered" or "Cancelled"){<AuthorizeView Policy="@AppPolicies.Administration"><Authorized><button class="delete-menu-action" @onclick="()=>OpenArchiveDialog(x)">Eliminar de la vista</button></Authorized></AuthorizeView>}@if(x.Status!="Delivered"&&x.Status!="Cancelled"){<a href="/app/pedidos/@x.Id">Editar pedido</a><button class="delete-menu-action" @onclick="()=>OpenRemoveDialog(x)">Eliminar pedido</button>}@if(x.Status=="Confirmed"||x.Status=="InPreparation"||x.Status=="Ready"){<a href="/app/entregas">Organizar entrega</a>}@if(x.Status!="Cancelled"&&x.PaymentStatus!="Paid"){<AuthorizeView Roles="Administrador,Finanzas"><Authorized><a href="/app/pedidos/@x.Id">Registrar pago</a></Authorized></AuthorizeView>}@if(x.PaymentStatus!="Pending"){<a href="/app/pedidos/@x.Id">Ver pagos y comprobantes</a>}@if(!string.IsNullOrWhiteSpace(x.ContactPhone)){<a href="@WhatsApp(x.ContactPhone)" target="_blank">WhatsApp</a>}@if(!string.IsNullOrWhiteSpace(x.LocationUrl)){<a href="@x.LocationUrl" target="_blank">Ubicación</a>}</nav></details></article>}</div>
   }
  </section>
  <aside class="orders-insights">
   <section><header><h2>Pagos del día</h2><time>@DateTime.Today.ToString("d MMM yyyy")</time></header><div class="insight-row qr"><span>▣ QR<small>@TodayQrCount pagos</small></span><strong>Bs @TodayQrAmount.ToString("N2")</strong></div><div class="insight-row cash"><span>▣ Efectivo<small>@TodayCashCount pagos</small></span><strong>Bs @TodayCashAmount.ToString("N2")</strong></div><div class="insight-row unpaid"><span>▭ Sin pago</span><strong>@TodayNoPaymentCount pedidos</strong></div></section>
   <section><h2>Resumen de montos</h2><dl><div><dt>Total en pedidos</dt><dd>Bs @Filtered.Sum(x => x.Total).ToString("N2")</dd></div><div><dt>Total pagado</dt><dd class="paid-value">Bs @Filtered.Sum(x => x.Paid).ToString("N2")</dd></div><div class="outstanding"><dt>Pendiente x cobrar</dt><dd>Bs @Filtered.Sum(x => x.Balance).ToString("N2")</dd></div></dl></section>
   <section class="units-panel"><header><h2>Unidades por tipo <small>(pendientes)</small></h2></header><div class="units-breakdown"><div class="unit-metric sale"><span>Para venta</span><strong>@PendingSaleUnits uds</strong><div><i style="width:@BarWidth(PendingSaleUnits)%"></i></div></div><div class="unit-metric replacement"><span>Reposiciones</span><strong>@PendingReplacementUnits uds</strong><div><i style="width:@BarWidth(PendingReplacementUnits)%"></i></div></div><div class="unit-metric tasting"><span>Degustaciones</span><strong>@PendingTastingUnits uds</strong><div><i style="width:@BarWidth(PendingTastingUnits)%"></i></div></div><div class="unit-total"><span>Total por entregar</span><strong>@PendingUnits uds</strong></div></div></section>
  </aside>
 </div>
}
@if (_showDelete)
{
 <div class="modal-backdrop delete-backdrop" @onclick="CloseDeleteDialog"><section class="delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation><h2 id="delete-title">Eliminar pedido #@DeleteCandidate?.Number</h2><p>Se eliminará definitivamente el pedido pendiente de <strong>@DeleteCandidate?.Customer</strong>.</p>@if (_error is not null) { <p class="orders-error" role="alert">@_error</p> }<footer><button class="secondary-action" @onclick="CloseDeleteDialog" disabled="@_deleting">Conservar pedido</button><button class="danger-action" @onclick="DeleteAsync" disabled="@(_deleteOrderId is null||_deleting)">@(_deleting ? "Eliminando…" : "Eliminar pedido")</button></footer></section></div>
}
@if (_showCancel)
{
 <div class="modal-backdrop delete-backdrop" @onclick="CloseCancelDialog"><section class="delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="cancel-title" @onclick:stopPropagation><h2 id="cancel-title">Eliminar pedido #@CancelCandidate?.Number</h2><p>Se retirará de la lista y se liberará el inventario reservado.</p><label>Motivo <span class="required">*</span><input @bind="_cancelReason" placeholder="Ej.: pedido cancelado por el cliente" /></label>@if (_error is not null) { <p class="orders-error" role="alert">@_error</p> }<footer><button class="secondary-action" @onclick="CloseCancelDialog" disabled="@_cancelling">Conservar pedido</button><button class="danger-action" @onclick="CancelOrderAsync" disabled="@(_cancelOrderId is null||_cancelling||string.IsNullOrWhiteSpace(_cancelReason))">@(_cancelling ? "Eliminando…" : "Eliminar pedido")</button></footer></section></div>
}
@if (_showArchive)
{
 <div class="modal-backdrop delete-backdrop" @onclick="CloseArchiveDialog"><section class="delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="archive-title" @onclick:stopPropagation><h2 id="archive-title">Eliminar pedido #@ArchiveCandidate?.Number de la vista</h2><p>El pedido y su saldo dejarán de aparecer en pedidos y cuentas por cobrar. Los pagos, entregas y comprobantes ya registrados se conservarán en el historial.</p><label>Motivo <span class="required">*</span><input @bind="_archiveReason" placeholder="Explica por qué se retira el pedido" /></label>@if (_error is not null) { <p class="orders-error" role="alert">@_error</p> }<footer><button class="secondary-action" @onclick="CloseArchiveDialog" disabled="@_archiving">Conservar pedido</button><button class="danger-action" @onclick="ArchiveOrderAsync" disabled="@(_archiveOrderId is null||_archiving||string.IsNullOrWhiteSpace(_archiveReason))">@(_archiving ? "Eliminando…" : "Eliminar de la vista")</button></footer></section></div>
}
@if (_showCreate)
{
 <div class="modal-backdrop" @onclick="CloseCreateDialog">
  <section class="create-panel" role="dialog" aria-modal="true" aria-labelledby="create-title" @onclick:stopPropagation>
   <header><div><small>Nueva venta</small><h2 id="create-title">Crear pedido</h2></div><a href="/app/pedidos" data-enhance-nav="false" class="close-button" aria-label="Cerrar">×</a></header>
   <p>Selecciona el cliente para iniciar un borrador. La reserva de stock se crea al confirmar el pedido con productos y fecha de entrega.</p>
   @if (_error is not null) { <p class="create-error" role="alert">@_error</p> }
   @if (_customers.Count == 0) { <p class="create-empty">Aún no hay clientes activos. <a href="/app/clientes">Registra un cliente</a> para crear el pedido.</p> }
   <label>Cliente<select @bind="_customerId" disabled="@(_creating || _customers.Count == 0)"><option value="">Selecciona un cliente</option>@foreach(var c in _customers){<option value="@c.Id">@c.Name</option>}</select></label>
   <footer><a href="/app/pedidos" data-enhance-nav="false" class="secondary-action">Cancelar</a><button type="button" class="primary-action" @onclick="CreateAsync" disabled="@_creating">@(_creating ? "Creando…" : "Crear pedido")</button></footer>
  </section>
 </div>
}
@code {
 private IReadOnlyList<OrderListItem>? _items; private IReadOnlyList<OrderOption> _customers=[]; private Guid? _customerId,_deleteOrderId,_cancelOrderId,_archiveOrderId; private string? _error; private string _search="",_statusFilter="All",_paymentFilter="All",_methodFilter="All",_dateFilter="All",_activeChip="All",_cancelReason="",_archiveReason=""; private bool _showCreate,_creating,_showDelete,_deleting,_showCancel,_cancelling,_showArchive,_archiving; private int _menuVersion; private DateTime Today=>DateTime.Today;
 private Microsoft.JSInterop.IJSObjectReference? _actionMenuModule;
 private async Task PositionMenuAsync(object menuId){_actionMenuModule??=await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import","./js/order-action-menu.js");await _actionMenuModule.InvokeVoidAsync("positionOrderActionMenu",menuId.ToString());}
 public async ValueTask DisposeAsync(){if(_actionMenuModule is null)return;try{await _actionMenuModule.InvokeVoidAsync("disposeOrderActionMenus");await _actionMenuModule.DisposeAsync();}catch(Microsoft.JSInterop.JSDisconnectedException){}}
 private List<OrderListItem> Filtered=>(_items??[]).Where(x=>(string.IsNullOrWhiteSpace(_search)||x.Number.ToString().Contains(_search.Trim(),StringComparison.OrdinalIgnoreCase)||x.Customer.Contains(_search.Trim(),StringComparison.OrdinalIgnoreCase)||(x.DeliveryPoint?.Contains(_search.Trim(),StringComparison.OrdinalIgnoreCase)??false)||x.Products.Any(p=>p.Contains(_search.Trim(),StringComparison.OrdinalIgnoreCase)))&&StatusMatches(x)&&(_paymentFilter=="All"||x.PaymentStatus==_paymentFilter)&&(_methodFilter=="All"||x.PaymentMethod==_methodFilter||x.PaymentMethod=="Mixed")&&DateMatches(x)&&ChipMatches(x)).ToList();
 private OrderListItem? DeleteCandidate=>_items?.SingleOrDefault(x=>x.Id==_deleteOrderId);
 private OrderListItem? CancelCandidate=>_items?.SingleOrDefault(x=>x.Id==_cancelOrderId);
 private OrderListItem? ArchiveCandidate=>_items?.SingleOrDefault(x=>x.Id==_archiveOrderId);
 private bool StatusMatches(OrderListItem x)=>_statusFilter switch{"All"=>x.Status!="Cancelled"&&(_activeChip=="Draft"||x.Status!="Draft"),"Pending"=>x.Status is not "Draft" and not "Delivered" and not "Cancelled","Draft"=>x.Status=="Draft","Delivered"=>x.Status=="Delivered",_=>false};
 private int ListCount=>_items?.Count(x=>x.Status is not "Cancelled" and not "Draft")??0; private int DraftCount=>_items?.Count(x=>x.Status=="Draft")??0; private int PendingCount=>_items?.Count(x=>x.Status is not "Draft" and not "Delivered" and not "Cancelled")??0; private int DeliveredCount=>_items?.Count(x=>x.Status=="Delivered")??0; private int UnpaidCount=>_items?.Count(x=>x.PaymentStatus=="Pending"&&x.Status is not "Draft" and not "Cancelled")??0; private int PaidCount=>_items?.Count(x=>x.PaymentStatus=="Paid")??0; private decimal OutstandingTotal=>_items?.Where(x=>x.Status is not "Draft" and not "Cancelled").Sum(x=>x.Balance)??0; private int PendingSaleUnits=>_items?.Where(x=>x.Status!="Draft").Sum(x=>x.PendingSaleQuantity)??0; private int PendingReplacementUnits=>_items?.Where(x=>x.Status!="Draft").Sum(x=>x.PendingReplacementQuantity)??0; private int PendingTastingUnits=>_items?.Where(x=>x.Status!="Draft").Sum(x=>x.PendingTastingQuantity)??0; private int PendingUnits=>PendingSaleUnits+PendingReplacementUnits+PendingTastingUnits; private double BarWidth(int value)=>PendingUnits==0?0:Math.Max(3,value*100d/PendingUnits); private int TodayQrCount=>_items?.Sum(x=>x.TodayQrPayments)??0; private decimal TodayQrAmount=>_items?.Sum(x=>x.TodayQrAmount)??0; private int TodayCashCount=>_items?.Sum(x=>x.TodayCashPayments)??0; private decimal TodayCashAmount=>_items?.Sum(x=>x.TodayCashAmount)??0; private int TodayNoPaymentCount=>UnpaidCount;
 protected override void OnParametersSet(){_showCreate=new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/app/pedidos/nuevo",StringComparison.OrdinalIgnoreCase);}
 protected override async Task OnInitializedAsync(){_items=await Service.ListAsync();_customers=await Service.CustomerOptionsAsync();}
 private void CloseCreateDialog(){if(!_creating)Navigation.NavigateTo("/app/pedidos");}
 private async Task CreateAsync(){if(_customerId is null){_error="Selecciona un cliente antes de crear el pedido.";return;}_creating=true;_error=null;try{var r=await Service.CreateDraftAsync(_customerId.Value,await UserIdAsync());if(r.Succeeded)Navigation.NavigateTo($"/app/pedidos/{r.Id}");else _error=string.Join(" ",r.Errors);}catch{_error="No se pudo crear el pedido. Intenta nuevamente.";}finally{_creating=false;}}
 private void OpenDeleteDialog(Guid orderId){_error=null;_deleteOrderId=orderId;_showDelete=true;}
 private void OpenRemoveDialog(OrderListItem item){if(item.Status=="Draft")OpenDeleteDialog(item.Id);else OpenCancelDialog(item.Id);}
 private void CloseDeleteDialog(){if(!_deleting)_showDelete=false;}
 private async Task DeleteAsync(){var item=_items?.SingleOrDefault(x=>x.Id==_deleteOrderId);if(item is null)return;_deleting=true;_error=null;try{var result=await Service.DeleteDraftAsync(item.Id,item.Version,await UserIdAsync());if(result.Succeeded){_items=_items?.Where(x=>x.Id!=item.Id).ToList();_showDelete=false;_deleteOrderId=null;_menuVersion++;}else _error=string.Join(" ",result.Errors);}catch{_error="No se pudo eliminar el pedido. Intenta nuevamente.";}finally{_deleting=false;}}
 private void OpenCancelDialog(Guid orderId){_error=null;_cancelReason="";_cancelOrderId=orderId;_showCancel=true;_menuVersion++;}
 private void CloseCancelDialog(){if(!_cancelling)_showCancel=false;}
 private async Task CancelOrderAsync()
 {
     var item=_items?.SingleOrDefault(x=>x.Id==_cancelOrderId);
     if(item is null)return;
     _cancelling=true;
     _error=null;
     try
     {
         var userId=await UserIdAsync();
         var updated=await Service.GetAsync(item.Id);
         if(updated?.Status!="Cancelled")
         {
             var cancelled=await Service.CancelAsync(item.Id,updated?.Version??item.Version,_cancelReason,userId);
             if(!cancelled.Succeeded){_error=string.Join(" ",cancelled.Errors);return;}
             updated=await Service.GetAsync(item.Id);
         }
         if(updated is null){_error="El pedido se canceló, pero no se pudo completar su eliminación de la vista.";return;}
         var archived=await Service.ArchiveAsync(item.Id,updated.Version,_cancelReason,userId);
         if(!archived.Succeeded){_error=string.Join(" ",archived.Errors);return;}
         _items=await Service.ListAsync();
         _showCancel=false;
         _cancelOrderId=null;
         _cancelReason="";
         _menuVersion++;
     }
     catch{_error="No se pudo retirar el pedido. Intenta nuevamente.";}
     finally{_cancelling=false;}
 }
 private void OpenArchiveDialog(OrderListItem item){_error=null;_archiveReason="";_archiveOrderId=item.Id;_showArchive=true;_menuVersion++;}
 private void CloseArchiveDialog(){if(!_archiving){_showArchive=false;_archiveOrderId=null;}}
 private async Task ArchiveOrderAsync(){var item=ArchiveCandidate;if(item is null)return;_archiving=true;_error=null;try{var result=await Service.ArchiveAsync(item.Id,item.Version,_archiveReason,await UserIdAsync());if(result.Succeeded){_items=await Service.ListAsync();_showArchive=false;_archiveOrderId=null;_archiveReason="";_menuVersion++;}else _error=string.Join(" ",result.Errors);}catch{_error="No se pudo eliminar el pedido de la vista. Intenta nuevamente.";}finally{_archiving=false;}}
 private async Task<Guid>UserIdAsync(){var s=await AuthenticationStateProvider.GetAuthenticationStateAsync();return Guid.Parse(s.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}
 private void SetChip(string value){_activeChip=value;_statusFilter="All";_paymentFilter="All";_methodFilter="All";if(value=="Qr")_methodFilter="Qr";else if(value=="Cash")_methodFilter="Cash";}
 private bool ChipMatches(OrderListItem x)=>_activeChip switch{"Draft"=>x.Status=="Draft","Pending"=>x.Status is not "Draft" and not "Delivered" and not "Cancelled","Delivered"=>x.Status=="Delivered","Unpaid"=>x.Status!="Draft"&&x.PaymentStatus=="Pending","Paid"=>x.PaymentStatus=="Paid","Qr"=>x.PaymentMethod is "Qr" or "Mixed","Cash"=>x.PaymentMethod is "Cash" or "Mixed","Replacement"=>x.ReplacementQuantity>0,"Tasting"=>x.TastingQuantity>0,_=>true}; private string ChipClass(string value)=>_activeChip==value?"active":string.Empty;
 private bool DateMatches(OrderListItem x){var date=x.PromisedAtUtc?.ToLocalTime().Date;if(_dateFilter=="All")return true;if(date is null)return false;return _dateFilter switch{"Today"=>date==Today,"Tomorrow"=>date==Today.AddDays(1),"Week"=>date>=Today&&date<Today.AddDays(7),"Late"=>date<Today&&x.Status is not "Delivered" and not "Cancelled",_=>true};} private bool IsLate(OrderListItem x)=>x.PromisedAtUtc?.ToLocalTime().Date<Today&&x.Status is not "Delivered" and not "Cancelled";
 private string DeliveryDateText(OrderListItem x){if(x.PromisedAtUtc is null)return "Sin fecha";var d=x.PromisedAtUtc.Value.ToLocalTime().Date;if(d==Today)return "Hoy";if(d==Today.AddDays(1))return "Mañana";if(IsLate(x))return $"Atrasado {(Today-d).Days} d";return d.ToString("d MMM");} private string DateClass(OrderListItem x)=>IsLate(x)?"date-badge late":x.PromisedAtUtc?.ToLocalTime().Date is var d&&(d==Today||d==Today.AddDays(1))?"date-badge soon":"date-text";
 private static string StatusText(string x)=>x switch{"Draft"=>"Borrador","Delivered"=>"Entregado","Cancelled"=>"Cancelado",_=>"Pendiente"}; private static string StatusClass(string x)=>x switch{"Draft"=>"status-draft","Delivered"=>"status-delivered","Cancelled"=>"status-cancelled",_=>"status-pending"};
 private static string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0]))); private static string PaymentText(string x)=>x switch{"Pending"=>"Sin pago","Partial"=>"Parcial","Paid"=>"Pagado","Refunded"=>"Reembolsado",_=>x}; private static string PaymentSummary(OrderListItem x)=>x.PaymentStatus=="Pending"?"Sin pago":$"{PaymentText(x.PaymentStatus)} · {MethodText(x.PaymentMethod)}"; private static string WhatsApp(string phone){var digits=new string(phone.Where(char.IsDigit).ToArray());if(digits.Length==8)digits="591"+digits;return $"https://wa.me/{digits}";} private static string PaymentClass(string x)=>$"payment-{x.ToLowerInvariant()}"; private static string MethodText(string? x)=>x switch{"Qr"=>"QR","Cash"=>"Efectivo","Transfer"=>"Transferencia","Mixed"=>"Mixto",_=>"—"}; private static string MethodClass(string? x)=>x switch{"Qr"=>"method-qr","Cash"=>"method-cash","Transfer"=>"method-transfer","Mixed"=>"method-mixed",_=>"method-none"};
}
