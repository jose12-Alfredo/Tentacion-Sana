@page "/app/arqueo"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.ManageFinance)]
@inject ICashLedgerService Ledger
@inject IAccountingAccountService AccountingAccounts
@inject AuthenticationStateProvider Auth
<PageTitle>Caja y flujo de efectivo | Tentación Sana</PageTitle>
<style>
    .cash-modal-actions { display:flex; gap:.5rem; }
    .cash-table .danger-action, .cash-modal-actions .danger-action { color:#a5221d; }
    .cash-modal-actions button { min-height:2.5rem; padding:.45rem .8rem; border:1px solid #b8ccb9; border-radius:.55rem; background:#fff; color:#246b45; font-weight:700; cursor:pointer; }
    .cash-modal-actions .danger-action { border-color:#e5b8b5; }
    .cash-modal-backdrop { position:fixed; inset:0; z-index:1000; display:grid; place-items:center; padding:1rem; background:#0009; }
    .cash-modal { width:min(48rem,100%); max-height:90vh; overflow:auto; padding:1.4rem; border-radius:1rem; background:#fff; box-shadow:0 1rem 3rem #0004; }
    .cash-modal h2 { margin:0 0 1rem; }
    .cash-modal > label { display:grid; gap:.4rem; }
    .cash-modal > label input { width:100%; min-height:2.8rem; padding:.6rem; border:1px solid #cbd7c7; border-radius:.5rem; }
    .cash-modal-actions { justify-content:flex-end; margin-top:1rem; }
    .cash-modal-actions .save { margin-top:0; background:#267a32; color:#fff; }
</style>
<header class="cash-heading"><div><p>Control financiero</p><h1>Caja y flujo de efectivo</h1><span>Dos cuentas independientes. Cada boliviano conserva su ubicación.</span></div><button @onclick="()=>_showCount=!_showCount">Hacer arqueo</button></header>
@if(_message is not null){<p class="cash-ok">@_message</p>} @if(_errors.Count>0){<div class="cash-errors">@foreach(var e in _errors){<p>@e</p>}</div>}
<section class="account-ledger"><article class="cash-account"><small>Caja / efectivo</small><strong>Bs @_dashboard.CashBalance.ToString("N2")</strong><span>Dinero físico</span></article><article class="bank-account"><small>Banco / QR</small><strong>Bs @_dashboard.BankBalance.ToString("N2")</strong><span>Saldo bancario</span></article><article><small>Total disponible</small><strong>Bs @TotalAvailable.ToString("N2")</strong></article><article><small>Entradas del mes</small><strong>Bs @_dashboard.TotalIncome.ToString("N2")</strong></article><article><small>Salidas del mes</small><strong>Bs @_dashboard.TotalExpense.ToString("N2")</strong></article><article class="net"><small>Flujo neto</small><strong>Bs @_dashboard.NetFlow.ToString("N2")</strong><span>Sin transferencias</span></article></section>
<section class="operation-panel"><nav class="operation-tabs"><button class="@IncomeTabClass" @onclick="SelectIncome">Registrar entrada</button><button class="@ExpenseTabClass" @onclick="SelectExpense">Registrar salida</button><button class="@TransferTabClass" @onclick="SelectTransfer">Transferir entre cuentas</button></nav>
@if(_tab=="Transfer"){<div class="operation-copy"><small>Movimiento interno</small><h2>Transferir entre cuentas</h2><p>No modifica el flujo del negocio.</p></div><div class="cash-fields"><label>Origen *<select @bind="_fromAccount"><option value="Bank">Banco / QR</option><option value="Cash">Caja / efectivo</option></select></label><label>Destino *<select @bind="_toAccount"><option value="Cash">Caja / efectivo</option><option value="Bank">Banco / QR</option></select></label><label>Monto *<input type="number" min="0.01" step="0.01" @bind="_amount" /></label><label>Fecha *<input type="date" @bind="_date" /></label><label class="wide">Detalle *<input @bind="_detail" placeholder="Ej.: retiro de banco para caja" /></label><label class="wide">Respaldo *<InputFile OnChange="e=>_file=e.File" accept="image/jpeg,image/png,image/webp" /></label></div><button class="save" @onclick="TransferAsync" disabled="@_saving">@(_saving?"Transfiriendo…":"Transferir dinero")</button>}
else{<div class="operation-copy"><small>@(_tab=="Income"?"Ingreso del negocio":"Egreso del negocio")</small><h2>@(_tab=="Income"?"Registrar entrada":"Registrar salida")</h2><p>@(_tab=="Income"?"Elige dónde entra el dinero y la cuenta contable que explica su origen.":"La cuenta contable define cómo afectará esta salida al estado de resultados.")</p></div><div class="cash-fields"><label>Cuenta de dinero *<select @bind="_account"><option value="Cash">Caja / efectivo</option><option value="Bank">Banco / QR</option></select></label><label>Cuenta contable *<select @bind="_accountingAccountId"><option value="@Guid.Empty">Selecciona</option>@foreach(var c in CurrentAccountingAccounts){<option value="@c.Id">@c.Code · @c.Name</option>}</select></label><label>Monto *<input type="number" min="0.01" step="0.01" @bind="_amount" /></label><label>Fecha *<input type="date" @bind="_date" /></label><label class="wide">Detalle *<input @bind="_detail" /></label><label class="wide">Respaldo *<InputFile OnChange="e=>_file=e.File" accept="image/jpeg,image/png,image/webp" /></label></div>@if(_accountingAccountId!=Guid.Empty){<p class="accounting-hint">@CategoryExplanation</p>}<button class="save" @onclick="RegisterAsync" disabled="@_saving">@(_saving?"Guardando…":_tab=="Income"?"Registrar entrada":"Registrar salida")</button>}</section>
@if(_showCount){<section class="count-panel"><div class="operation-copy"><small>Arqueo real · solo efectivo</small><h2>Contar Caja / efectivo</h2></div><div class="count-grid"><label>Saldo esperado<input value="@_dashboard.CashBalance.ToString("0.00")" readonly /></label><label>Efectivo contado<input type="number" min="0" step="0.01" @bind="_counted" /></label><label>Diferencia<input value="@CountDifference.ToString("0.00")" readonly class="@(CountDifference==0?"balanced":"difference")" /></label><label>Observación<input @bind="_countObservation" /></label><label>Respaldo @(CountDifference==0?"(opcional)":"*")<InputFile OnChange="e=>_countFile=e.File" accept="image/jpeg,image/png,image/webp" /></label></div><button class="save" @onclick="CountAsync" disabled="@_saving">Guardar arqueo</button></section>}
<section class="cash-history"><header><div><small>Libro de movimientos</small><h2>Movimientos por cuenta</h2></div><span>@FilteredMovements.Count resultado(s)</span></header><div class="filters"><input @bind="_search" @bind:event="oninput" placeholder="Buscar movimiento" aria-label="Buscar movimientos" /><select @bind="_filterAccount"><option value="">Todas las cuentas</option><option value="Cash">Caja / efectivo</option><option value="Bank">Banco / QR</option></select><select @bind="_filterType"><option value="">Todos los tipos</option><option value="Income">Entradas</option><option value="Expense">Salidas</option></select><select @bind="_filterCategory"><option value="">Todas las categorías</option>@foreach(var c in AllCategories){<option value="@c">@c</option>}</select><select @bind="_filterSource"><option value="">Todos los orígenes</option><option value="Automatic">Automático</option><option value="Manual">Manual</option><option value="Transfer">Transferencias</option></select><input type="date" @bind="_filterDate" aria-label="Filtrar por fecha" /></div><div class="quick-filters"><button @onclick="ClearFilters">Todos</button><button @onclick="FilterCash">Caja</button><button @onclick="FilterBank">Banco / QR</button><button @onclick="FilterIncome">Entradas</button><button @onclick="FilterExpense">Salidas</button><button @onclick="TransferFilter">Transferencias</button></div>
<div class="cash-table"><table><thead><tr><th>Fecha</th><th>Cuenta</th><th>Tipo</th><th>Categoría</th><th>Detalle</th><th>Monto</th><th>Origen</th><th>Respaldo</th><th>Acciones</th></tr></thead><tbody>@foreach(var x in FilteredMovements){<tr><td data-label="Fecha">@x.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td data-label="Cuenta"><span class="account-chip @x.Account.ToLowerInvariant()">@AccountText(x.Account)</span></td><td data-label="Tipo"><span class="@(x.Direction=="Income"?"income":"expense")">@DirectionText(x.Direction)</span></td><td data-label="Categoría">@x.Category</td><td data-label="Detalle">@x.Detail</td><td data-label="Monto"><strong>Bs @x.Amount.ToString("N2")</strong></td><td data-label="Origen">@SourceText(x.Source)</td><td data-label="Respaldo"><button class="link" @onclick="()=>EvidenceAsync(x.Id)">Ver foto</button></td><td data-label="Acciones">@if(x.Source is "Manual" or "Transfer"){<button type="button" class="link" @onclick="() => OpenEdit(x)">Editar</button><button type="button" class="link danger-action" @onclick="() => OpenDelete(x)">Eliminar</button>}else{<span>Desde origen</span>}</td></tr>}</tbody></table></div>@if(_evidenceUrl is not null){<a class="evidence" href="@_evidenceUrl" target="_blank">Abrir respaldo ↗</a>}</section>
@if (_editing is not null)
{
    <div class="cash-modal-backdrop"><section class="cash-modal" role="dialog" aria-modal="true" aria-label="Editar movimiento"><h2>Editar @(_editing.Source == "Transfer" ? "transferencia" : "movimiento")</h2>@if(_errors.Count>0){<div class="cash-errors">@foreach(var error in _errors){<p>@error</p>}</div>}
        <div class="cash-fields"><label>@(_editing.Source == "Transfer" ? "Origen" : "Cuenta de dinero")<select @bind="_editAccount"><option value="Cash">Caja / efectivo</option><option value="Bank">Banco / QR</option></select></label>
        @if (_editing.Source == "Transfer") { <label>Destino<select @bind="_editOtherAccount"><option value="Cash">Caja / efectivo</option><option value="Bank">Banco / QR</option></select></label> }
        else { <label>Tipo<select @bind="_editDirection"><option value="Income">Entrada</option><option value="Expense">Salida</option></select></label><label>Cuenta contable<select @bind="_editAccountingAccountId"><option value="@Guid.Empty">Selecciona</option>@foreach (var account in EditableAccountingAccounts) { <option value="@account.Id">@account.Code · @account.Name</option> }</select></label> }
        <label>Fecha y hora<input type="datetime-local" @bind="_editAt" /></label><label>Monto<input type="number" min="0.01" step="0.01" @bind="_editAmount" /></label><label class="wide">Detalle<input @bind="_editDetail" maxlength="500" /></label><label class="wide">Motivo de la corrección<input @bind="_editReason" maxlength="500" /></label></div>
        <p>La foto de respaldo original se conserva.</p><div class="cash-modal-actions"><button type="button" @onclick="CloseDialogs">Cancelar</button><button type="button" class="save" @onclick="SaveEditAsync" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar corrección")</button></div>
    </section></div>
}
@if (_deleting is not null)
{
    <div class="cash-modal-backdrop"><section class="cash-modal" role="alertdialog" aria-modal="true" aria-label="Eliminar movimiento"><h2>Eliminar @(_deleting.Source == "Transfer" ? "transferencia" : "movimiento")</h2>@if(_errors.Count>0){<div class="cash-errors">@foreach(var error in _errors){<p>@error</p>}</div>}<p>Se recalcularán los saldos y quedará un registro de auditoría. Una transferencia elimina tanto la salida como la entrada.</p><label>Motivo de eliminación<input @bind="_deleteReason" maxlength="500" /></label><div class="cash-modal-actions"><button type="button" @onclick="CloseDialogs">Cancelar</button><button type="button" class="danger-action" @onclick="DeleteMovementAsync" disabled="@_saving">@(_saving ? "Eliminando…" : "Eliminar")</button></div></section></div>
}
@if(_dashboard.Payables.Count>0){<section class="cash-history"><header><div><small>Rendiciones</small><h2>Cuentas por pagar</h2></div></header><div class="cash-table"><table><thead><tr><th>Fecha</th><th>Persona</th><th>Monto</th><th>Estado</th></tr></thead><tbody>@foreach(var x in _dashboard.Payables){<tr><td data-label="Fecha">@x.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td data-label="Persona">@x.Person</td><td data-label="Monto">Bs @x.Amount.ToString("N2")</td><td data-label="Estado">@(x.Status=="Pending"?"Pendiente":"Pagada")</td></tr>}</tbody></table></div></section>}
@code{
private CashMovementItem? _editing, _deleting;
private string _editAccount="Cash", _editOtherAccount="Bank", _editDirection="Income", _editDetail="", _editReason="", _deleteReason="";
private Guid _editAccountingAccountId;
private DateTime _editAt;
private decimal _editAmount;
private IEnumerable<AccountingAccountItem> EditableAccountingAccounts => _accountingAccounts.Where(x => x.IsActive && (_editDirection == "Income" ? x.Kind is "Income" or "Liability" or "Equity" : x.Kind is "DirectCost" or "OperatingExpense" or "Asset"));
private void OpenEdit(CashMovementItem item)
{
    _errors.Clear(); _message=null; _editing=item; _deleting=null;
    _editDirection=item.Direction; _editAt=item.OccurredAtUtc.ToLocalTime().DateTime;
    _editDetail=item.Detail; _editAmount=item.Amount; _editAccountingAccountId=item.AccountingAccountId??Guid.Empty; _editReason="";
    _editAccount=item.Source=="Transfer" && item.Direction=="Income" ? (item.Account=="Cash"?"Bank":"Cash") : item.Account;
    _editOtherAccount=_editAccount=="Cash"?"Bank":"Cash";
}
private void OpenDelete(CashMovementItem item){_errors.Clear();_message=null;_deleting=item;_editing=null;_deleteReason="";}
private void CloseDialogs(){_editing=null;_deleting=null;}
private async Task SaveEditAsync()
{
    if(_editing is null)return;
    _errors.Clear();_saving=true;
    try
    {
        var at=new DateTimeOffset(DateTime.SpecifyKind(_editAt,DateTimeKind.Local)).ToUniversalTime();
        var result=await Ledger.UpdateMovementAsync(new(_editing.Id,_editAccount,_editOtherAccount,_editDirection,_editAccountingAccountId,at,_editDetail,_editAmount,_editReason),await UserId());
        if(!result.Succeeded){_errors.AddRange(result.Errors);return;}
        CloseDialogs();_message="Movimiento corregido. Los saldos fueron recalculados.";await Reload();
    }
    catch{_errors.Add("No se pudo corregir el movimiento.");}
    finally{_saving=false;}
}
private async Task DeleteMovementAsync()
{
    if(_deleting is null)return;
    _errors.Clear();_saving=true;
    try
    {
        var result=await Ledger.DeleteMovementAsync(new(_deleting.Id,_deleteReason),await UserId());
        if(!result.Succeeded){_errors.AddRange(result.Errors);return;}
        CloseDialogs();_message="Movimiento eliminado. Los saldos fueron recalculados.";await Reload();
    }
    catch{_errors.Add("No se pudo eliminar el movimiento.");}
    finally{_saving=false;}
}
private IReadOnlyList<AccountingAccountItem> _accountingAccounts=[];private CashDashboard _dashboard=new(0,0,0,0,0,[],[]);private readonly List<string>_errors=[];private string? _message,_evidenceUrl;private string _tab="Income",_account="Cash",_fromAccount="Bank",_toAccount="Cash",_detail="",_search="",_filterAccount="",_filterType="",_filterCategory="",_filterSource="",_countObservation="";private Guid _accountingAccountId;private decimal _amount,_counted;private DateTime _date=DateTime.Today;private DateTime? _filterDate;private IBrowserFile? _file,_countFile;private bool _saving,_showCount;
private decimal TotalAvailable=>_dashboard.CashBalance+_dashboard.BankBalance;private decimal CountDifference=>_counted-_dashboard.CashBalance;private IEnumerable<AccountingAccountItem>CurrentAccountingAccounts=>_accountingAccounts.Where(x=>x.IsActive&&(_tab=="Income"?x.Kind is "Income" or "Liability" or "Equity":x.Kind is "DirectCost" or "OperatingExpense" or "Asset"));private IEnumerable<string>AllCategories=>_dashboard.Movements.Select(x=>x.Category).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().Order();private string IncomeTabClass=>_tab=="Income"?"active":"";private string ExpenseTabClass=>_tab=="Expense"?"active":"";private string TransferTabClass=>_tab=="Transfer"?"active":"";
private string CategoryExplanation=>_accountingAccounts.FirstOrDefault(x=>x.Id==_accountingAccountId)?.Kind switch{"DirectCost"=>"Costo directo: se mostrará junto al costo de ventas.","OperatingExpense"=>"Gasto operativo: reducirá la utilidad del período.","Asset"=>"Inversión: se mostrará fuera del resultado y no reducirá inmediatamente la utilidad.","Liability"=>"Pasivo: es dinero recibido que todavía se debe cumplir o devolver.","Equity"=>"Patrimonio: es un aporte del propietario y no es ingreso del negocio.",_=>"Ingreso: aumentará el resultado del período."};
private List<CashMovementItem>FilteredMovements=>_dashboard.Movements.Where(x=>(string.IsNullOrWhiteSpace(_search)||x.Detail.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.Category.Contains(_search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrEmpty(_filterAccount)||x.Account==_filterAccount)&&(string.IsNullOrEmpty(_filterType)||x.Direction==_filterType)&&(string.IsNullOrEmpty(_filterCategory)||x.Category==_filterCategory)&&(string.IsNullOrEmpty(_filterSource)||SourceGroup(x.Source)==_filterSource)&&(_filterDate is null||x.OccurredAtUtc.ToLocalTime().Date==_filterDate.Value.Date)).ToList();
protected override async Task OnInitializedAsync(){_accountingAccounts=await AccountingAccounts.GetAllAsync();await Reload();_counted=_dashboard.CashBalance;}private async Task Reload()=>_dashboard=await Ledger.GetDashboardAsync();private void SelectTab(string x){_tab=x;_accountingAccountId=Guid.Empty;_errors.Clear();_message=null;}private void SelectIncome()=>SelectTab("Income");private void SelectExpense()=>SelectTab("Expense");private void SelectTransfer()=>SelectTab("Transfer");
private async Task RegisterAsync(){if(_accountingAccountId==Guid.Empty){_errors.Clear();_errors.Add("Selecciona una cuenta contable.");return;}if(!ValidateFile())return;await Run(async s=>await Ledger.RegisterManualAsync(new(_account,_tab,_accountingAccountId,UtcDate(),_detail,_amount,s!,_file!.Name,_file.ContentType,_file.Size),await UserId()),"Movimiento registrado.");}private async Task TransferAsync(){if(_fromAccount==_toAccount){_errors.Clear();_errors.Add("El origen y destino deben ser diferentes.");return;}if(!ValidateFile())return;await Run(async s=>await Ledger.TransferAsync(new(_fromAccount,_toAccount,UtcDate(),_detail,_amount,s!,_file!.Name,_file.ContentType,_file.Size),await UserId()),"Transferencia registrada.");}
private async Task CountAsync(){_errors.Clear();if(CountDifference!=0&&_countFile is null){_errors.Add("Adjunta una foto cuando exista diferencia.");return;}_saving=true;try{Stream? s=null;if(_countFile is not null)s=_countFile.OpenReadStream(10*1024*1024);await using(s){var r=await Ledger.RegisterCashCountAsync(new(UtcDate(),_counted,_countObservation,s,_countFile?.Name,_countFile?.ContentType,_countFile?.Size??0),await UserId());if(!r.Succeeded){_errors.AddRange(r.Errors);return;}}_message="Arqueo guardado.";_showCount=false;await Reload();}catch{_errors.Add("No se pudo guardar el arqueo.");}finally{_saving=false;}}
private bool ValidateFile(){_errors.Clear();_message=null;if(_file is null){_errors.Add("La foto del respaldo es obligatoria.");return false;}return true;}private async Task Run(Func<Stream?,Task<CashResult>> action,string message){_saving=true;try{await using var s=_file!.OpenReadStream(10*1024*1024);var r=await action(s);if(!r.Succeeded){_errors.AddRange(r.Errors);return;}_message=message;_detail="";_amount=0;_file=null;await Reload();}catch{_errors.Add("No se pudo registrar la operación.");}finally{_saving=false;}}
private async Task EvidenceAsync(Guid id){var r=await Ledger.GetEvidenceUrlAsync(id,await UserId());if(r.Succeeded)_evidenceUrl=r.Url;else{_errors.Clear();_errors.AddRange(r.Errors);}}private DateTimeOffset UtcDate()=>new DateTimeOffset(DateTime.SpecifyKind(_date,DateTimeKind.Local)).ToUniversalTime();private async Task<Guid>UserId(){var s=await Auth.GetAuthenticationStateAsync();return Guid.Parse(s.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}private void ClearFilters(){_search=_filterAccount=_filterType=_filterCategory=_filterSource="";_filterDate=null;}private void FilterCash(){ClearFilters();_filterAccount="Cash";}private void FilterBank(){ClearFilters();_filterAccount="Bank";}private void FilterIncome(){ClearFilters();_filterType="Income";}private void FilterExpense(){ClearFilters();_filterType="Expense";}private void TransferFilter(){ClearFilters();_filterSource="Transfer";}private static string AccountText(string x)=>x=="Bank"?"Banco / QR":"Caja / efectivo";private static string DirectionText(string x)=>x=="Income"?"Entrada":"Salida";private static string SourceGroup(string x)=>x=="Manual"?"Manual":x=="Transfer"?"Transfer":"Automatic";private static string SourceText(string x)=>x switch{"Manual"=>"Manual","Transfer"=>"Transferencia","CustomerPayment"=>"Automático · pago","InventoryPurchase"=>"Automático · compra","CashCountAdjustment"=>"Automático · arqueo",_=>x};}
