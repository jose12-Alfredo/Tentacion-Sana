<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TentacionSana.Application\TentacionSana.Application.csproj" />
    <ProjectReference Include="..\TentacionSana.Infrastructure\TentacionSana.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>ab352788-7b79-4224-8592-fc3c2de4fbb5</UserSecretsId>
  </PropertyGroup>

  <Target Name="CopyBlazorWebScriptForProduction" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot/_framework/blazor.web.js"
          DestinationFiles="$(PublishDir)wwwroot/js/blazor.web.js"
          SkipUnchangedFiles="true"
          Condition="Exists('$(PublishDir)wwwroot/_framework/blazor.web.js')" />
  </Target>

</Project>
