# Copia este archivo como .env solo para herramientas o plataformas que carguen
# archivos .env. ASP.NET Core usa estas mismas variables de entorno con "__".

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5091

# PostgreSQL / Neon (obligatoria para iniciar la aplicacion)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tentacion_sana;Username=postgres;Password=CAMBIAR;SSL Mode=Prefer

# Cloudinary (necesarias para imagenes y evidencias)
Cloudinary__CloudName=CAMBIAR
Cloudinary__ApiKey=CAMBIAR
Cloudinary__ApiSecret=CAMBIAR

# Numero comercial con codigo de pais
Business__WhatsAppNumber=+591CAMBIAR

# Usar solo una vez con: dotnet run --project src/TentacionSana.Web -- --seed-admin
BootstrapAdmin__UserName=admin@ejemplo.com
BootstrapAdmin__DisplayName=Administrador
BootstrapAdmin__TemporaryPassword=CAMBIAR_POR_UNA_CLAVE_TEMPORAL_SEGURA
